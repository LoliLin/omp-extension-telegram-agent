# Telegram bot tokens (Bot A = 小雪/hatsuyuki, Bot B = 小雨/kosame)
# 注意：本项目 .env 用冒号格式 `key: value`，不是 dotenv 的 KEY=value
teleram_hastuyuki_bot: 123456:AAA...
telegram_kosamerobot: 123456:BBB...
# Telegram group peer id：裸正数（不带 - 或 -100 前缀）。获取方法：
# 把群链接（如 t.me/+xxx）转发给 @userinfobot，或查看 getUpdates 返回的
# chat.id 的正数部分（-1004402809405 就写 4402809405）。-100 前缀与负号会被自动归一化。
telegram_group_peer_id: 4402809405

# Main LLM provider (DeepSeek official API)
deepseek_api_key: sk-...
deepseek_model: deepseek-v4-flash
deepseek_reasoning_effort: medium

# TinyFish search API key
tiny_fish_api_key: ...

# Auxiliary vision model config (via local Codex authentication)
auxiliary_visual_model: gpt-5-mini

# Routing secret for deterministic router (HMAC key); any random string
router_secret: ...

# GPG key passphrase for signed commits (dev only, not used by daemon)
gpg_key_passphrase: ...
