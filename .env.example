# 本项目 .env 用冒号格式 `key: value`（不是 dotenv 的 KEY=value）。
# bot 列表、persona 路径、模型参数、routing 概率在 bots.config.json（复制 bots.config.example.json）。
# .env 只放 secret 与 API key。

# Telegram bot tokens（key 名要与 bots.config.json 里每个 bot 的 token_env 对应）
teleram_hastuyuki_bot: 123456:AAA...
telegram_kosamerobot: 123456:BBB...

# Main LLM provider key (the env name is selected by api_key_env in bot config)
deepseek_api_key: sk-...

# TinyFish search API key
tiny_fish_api_key: ...

# Auxiliary vision model config (via local Codex authentication)
auxiliary_visual_model: gpt-5-mini

# Routing secret for deterministic router (HMAC key); any random string
router_secret: ...

# GPG key passphrase for signed commits (dev only, not used by daemon)
gpg_key_passphrase: ...
