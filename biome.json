{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**/*.{ts,tsx,js,jsx,json,jsonc}",
			"!bun.lock",
			"!node_modules",
			"!data",
			"!build",
			"!dist",
			"!coverage"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"json": {
		"formatter": {
			"indentStyle": "tab"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noNonNullAssertion": "off",
				"useTemplate": "off"
			},
			"complexity": {
				"useOptionalChain": "off"
			},
			"suspicious": {
				"noControlCharactersInRegex": "off",
				"noExplicitAny": "off"
			}
		}
	},
	"assist": {
		"enabled": false
	}
}
