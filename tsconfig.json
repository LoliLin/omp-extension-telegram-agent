{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["bun-types", "node"],
		"lib": ["ES2023"],
		"verbatimModuleSyntax": true
	},
	"include": ["src/**/*", "test/**/*", "scripts/**/*"]
}
